# Copy to .env and adjust. The server reads process.env directly.
# With NODE_ENV=production the OAuth values below have NO defaults — a missing one aborts the start
# instead of silently falling back to a localhost issuer that does not exist in production.

PORT=8970
RESOURCE_URL=http://127.0.0.1:8970

# OAuth 2.1 authorization server (IdP). In prod: your real IdP (WorkOS/Auth0/Keycloak).
OAUTH_ISSUER=http://127.0.0.1:8969
OAUTH_JWKS_URI=http://127.0.0.1:8969/.well-known/jwks.json
OAUTH_AUDIENCE=http://127.0.0.1:8970
TENANT_CLAIM=tenant

# Origin allow-list against DNS rebinding (MCP Streamable HTTP requires Origin validation).
# Comma-separated. Requests without an Origin header (CLI, agent, server-to-server) always pass;
# a request WITH an Origin is rejected with 403 unless it is listed here. Empty = reject every
# browser origin, which is the right default for a token-only API.
ALLOWED_ORIGINS=

# Rate limiting (per tenant)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Audit log. The server refuses to start if this path is not writable.
AUDIT_LOG_PATH=audit.log.jsonl

# Store: "memory" (default) or "pg"
STORE=memory
# DATABASE_URL=postgres://mcp_app:password@localhost:5432/mcp   # required when STORE=pg
